#!/usr/bin/env bash
# devtools: know, reinstall and update every tool on this machine.
#   devtools inventory        scan this machine and rewrite packages/*
#   devtools install          install everything listed in packages/*
#   devtools upgrade          update every installed tool
#   devtools list             show what is recorded
# Flags: --dry-run (print only), --only <manager> (install/upgrade; one of:
#   brew fonts installers node rustup bun npm go cargo)
set -uo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
DOTFILES="$(cd "$(dirname "$src")/.." && pwd)"
PKG="$DOTFILES/packages"

DRY_RUN=0
ONLY=""
CMD="${1:-}"; [ $# -gt 0 ] && shift
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --only)    ONLY="${2:-}"; shift ;;
    *) echo "devtools: unknown flag $1" >&2; exit 1 ;;
  esac
  shift
done

say()  { printf '\n==> %s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }
want() { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }
run()  { echo "+ $*"; [ "$DRY_RUN" -eq 1 ] || "$@" || warn "failed: $*"; }
runsh() { echo "+ $1"; [ "$DRY_RUN" -eq 1 ] || bash -c "$1" || warn "failed: $1"; }

# lines <file>: non-empty, non-comment lines
lines() { local f; for f in "$@"; do [ -f "$f" ] && grep -vE '^[[:space:]]*(#|$)' "$f"; done; return 0; }

load_env() {  # make freshly installed tools visible in this process
  export PATH="$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/.local/bin:$HOME/go/bin:$PATH"
  [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
  local nvmdir="${NVM_DIR:-$HOME/.nvm}"
  [ -s "$nvmdir/nvm.sh" ] || nvmdir="$(brew --prefix nvm 2>/dev/null || true)"
  # shellcheck disable=SC1091
  [ -s "$nvmdir/nvm.sh" ] && { export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"; . "$nvmdir/nvm.sh"; }
  return 0
}

# ---------------------------------------------------------------- inventory
inventory() {
  mkdir -p "$PKG"

  if have brew; then
    say "brew"
    {
      echo "# Generated by devtools inventory: taps, top-level formulae (not dependencies), casks, editor extensions."
      brew tap | grep -v '^homebrew/' | sed 's/.*/tap "&"/'
      brew leaves --installed-on-request | sed 's/.*/brew "&"/'
      brew list --cask -1 | sed 's/.*/cask "&"/'
      have code && code --list-extensions 2>/dev/null | sed 's/.*/vscode "&"/'
    } > "$PKG/Brewfile"
    echo "wrote packages/Brewfile ($(grep -c '^brew' "$PKG/Brewfile") formulae, $(grep -c '^cask' "$PKG/Brewfile") casks)"
  fi

  if have bun; then
    say "bun globals"
    bun pm ls -g 2>/dev/null | sed -nE 's/^[├└]── (.+)@[^@]+$/\1/p' | sort > "$PKG/bun.txt"
    wc -l < "$PKG/bun.txt" | xargs echo "bun packages:"
  fi

  if have npm; then
    say "npm globals"
    npm ls -g --depth=0 --parseable 2>/dev/null | sed -n 's|.*/node_modules/||p' \
      | grep -vE '^(npm|corepack)$' | sort > "$PKG/npm.txt"
    wc -l < "$PKG/npm.txt" | xargs echo "npm packages:"
  fi

  if have go && [ -d "$HOME/go/bin" ]; then
    say "go tools"
    for f in "$HOME"/go/bin/*; do
      [ -f "$f" ] && go version -m "$f" 2>/dev/null | awk '$1 == "path" { print $2 }'
    done | sort -u > "$PKG/go.txt"
    wc -l < "$PKG/go.txt" | xargs echo "go tools:"
  fi

  if have rustup; then
    say "rust toolchains"
    # linked/custom toolchains (stage1, *-solana-*) cannot be reinstalled by name
    rustup toolchain list | awk '{print $1}' | grep -vE '^(stage1|.*sbpf.*|.*solana.*)$' \
      | sed 's/-aarch64-apple-darwin$//; s/-x86_64-.*$//' | sort -u > "$PKG/rustup.txt"
    wc -l < "$PKG/rustup.txt" | xargs echo "toolchains:"
  fi

  say "node versions (nvm)"
  if [ -d "${NVM_DIR:-$HOME/.nvm}/versions/node" ]; then
    find "${NVM_DIR:-$HOME/.nvm}/versions/node" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort -V > "$PKG/node.txt"
    wc -l < "$PKG/node.txt" | xargs echo "node versions:"
  else
    echo "nvm not found, skipping"
  fi

  say "cargo binaries (informational)"
  # cargo.txt is curated by hand: `cargo install --list` cannot see crates
  # installed from a path or from git, and many binaries here are your own.
  if [ -d "$HOME/.cargo/bin" ]; then
    ls "$HOME/.cargo/bin" > "$PKG/cargo-bins.txt"
    wc -l < "$PKG/cargo-bins.txt" | xargs echo "cargo bin files:"
  fi

  say "apps (/Applications)"
  apps_inventory

  say "fonts"
  fonts_inventory

  say "binaries with no known source"
  unknown_inventory
}

apps_inventory() {
  [ "$(uname -s)" = Darwin ] || { echo "macOS only"; return; }
  local out="$PKG/apps.txt" app name token info
  {
    echo "# GUI apps not installed through brew. Generated by devtools inventory."
    echo "# cask:<token> lines are installed by 'devtools install'; mas: and manual: are informational."
  } > "$out"
  for app in /Applications/*.app; do
    name="$(basename "$app" .app)"
    case "$name" in Safari|Utilities|Xcode|.*) continue ;; esac
    token="$(printf '%s' "$name" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
    if [ -d "$app/Contents/_MASReceipt" ]; then
      echo "mas: $name" >> "$out"; continue
    fi
    if have brew && brew list --cask "$token" >/dev/null 2>&1; then continue; fi  # already in Brewfile
    # Accept a cask only when its display name equals the app name exactly.
    if have brew && info="$(brew info --cask "$token" 2>/dev/null | sed -n '1p')" &&
       printf '%s\n' "$info" | sed -nE 's/^==> [^ ]+ \((.*)\):.*/\1/p' | tr ',' '\n' | sed 's/^ *//' | grep -qix "$name"; then
      echo "cask:$token" >> "$out"
    else
      echo "manual: $name" >> "$out"
    fi
  done
  sort -o "$out" "$out"
  grep -c '^cask:' "$out" | xargs echo "installable via brew cask:"
  grep -c '^manual:' "$out" | xargs echo "manual installs:"
}

fonts_inventory() {
  local out="$PKG/fonts.txt" d fam norm token casks installed
  # normalized name (lowercase, letters+digits only) -> cask token
  casks=""; installed=""
  if have brew; then
    casks="$(brew search --casks '/^font-/' 2>/dev/null)"
    installed="$(brew list --cask -1 2>/dev/null)"
  fi
  mkdir -p "$DOTFILES/assets/fonts"
  {
    echo "# Fonts found on this machine. Generated by devtools inventory."
    echo "# cask:<token> lines are installed by 'devtools install'; local: files live in assets/fonts."
    for d in "$HOME/Library/Fonts" "$HOME/.local/share/fonts"; do
      [ -d "$d" ] && find "$d" -maxdepth 1 -type f -exec basename {} \; | sed -E 's/\.(ttf|otf|ttc)$//; s/-.*$//; s/ NF .*/ NF/' \
        | sed -E 's/(MesloLG)[A-Z]*NerdFont.*/\1NerdFont/; s/(JetBrainsMono)(NL)?NerdFont.*/\1NerdFont/; s/JetBrainsMonoNL$/JetBrainsMono/'
    done | sort -u | while read -r fam; do
      norm="$(printf '%s' "$fam" | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]')"
      token="$(printf '%s\n' "$casks" | while read -r c; do
        [ "$(printf '%s' "${c#font-}" | tr -d '-')" = "$norm" ] && { echo "$c"; break; }
      done)"
      if [ -n "$token" ]; then
        printf '%s\n' "$installed" | grep -qx "$token" || echo "cask:$token"   # installed ones are in the Brewfile
      else
        echo "local: $fam"
      fi
    done
  } > "$out"
  grep -c '^cask:' "$out" | xargs echo "fonts via brew cask:"
  # Fonts no cask provides are stored in the repo so a new machine gets them.
  for fam in $(sed -n 's/^local: //p' "$out" | tr ' ' '_'); do
    fam="${fam//_/ }"
    for d in "$HOME/Library/Fonts" "$HOME/.local/share/fonts"; do
      find "$d" -maxdepth 1 -type f -name "$fam*" -exec cp -n {} "$DOTFILES/assets/fonts/" \; 2>/dev/null
    done
  done
  echo "fonts stored in assets/fonts: $(find "$DOTFILES/assets/fonts" -type f | wc -l | tr -d ' ')"
}

unknown_inventory() {
  local out="$PKG/unknown.txt" f b
  {
    echo "# Binaries on your PATH dirs that no package manager list covers."
    echo "# Decide for each: add an installer to installers.tsv, add the crate to cargo.txt, or ignore."
    for f in "$HOME"/.local/bin/* "$HOME"/.cargo/bin/*; do
      [ -e "$f" ] || continue
      b="$(basename "$f")"
      grep -qxF "$b" "$PKG/ignore-bins.txt" 2>/dev/null && continue
      case "$(readlink "$f" 2>/dev/null)" in */homebrew/*|*/.bun/*) continue ;; esac
      echo "$b"
    done | sort -u
  } > "$out"
  grep -vc '^#' "$out" | xargs echo "unclassified binaries:"
  echo "(see packages/unknown.txt; list ones to ignore in packages/ignore-bins.txt)"
}

# ------------------------------------------------------------------ install
install_all() {
  load_env

  if want brew && have brew; then
    say "brew bundle"
    [ -f "$PKG/Brewfile" ] && run brew bundle --file="$PKG/Brewfile"
    local c
    for c in $(lines "$PKG/apps.txt" "$PKG/fonts.txt" | sed -n 's/^cask://p'); do
      brew list --cask "$c" >/dev/null 2>&1 || run brew install --cask "$c"
    done
  fi

  if want fonts; then
    say "fonts (assets/fonts)"
    local fdir="$HOME/.local/share/fonts" f
    [ "$(uname -s)" = Darwin ] && fdir="$HOME/Library/Fonts"
    if [ -d "$DOTFILES/assets/fonts" ]; then
      run mkdir -p "$fdir"
      for f in "$DOTFILES"/assets/fonts/*; do
        [ -f "$f" ] || continue
        [ -e "$fdir/$(basename "$f")" ] && { echo "ok    $(basename "$f")"; continue; }
        run cp "$f" "$fdir/"
      done
      [ "$(uname -s)" = Linux ] && have fc-cache && run fc-cache -f
    fi
  fi

  if want installers; then
    say "installers"
    local name detect inst _upd
    while IFS=$'\t' read -r name detect inst _upd; do
      [ -n "$name" ] || continue
      if bash -c "$detect" >/dev/null 2>&1; then echo "ok    $name"; else runsh "$inst"; load_env; fi
    done < <(lines "$PKG/installers.tsv")
  fi

  if want rustup && have rustup; then
    say "rust toolchains"
    local t
    for t in $(lines "$PKG/rustup.txt"); do run rustup toolchain install "$t" --profile minimal; done
  fi

  if want node && type nvm >/dev/null 2>&1; then
    say "node versions"
    local v
    for v in $(lines "$PKG/node.txt"); do run nvm install "$v"; done
  fi

  want bun   && have bun   && { say "bun globals"; local p; for p in $(lines "$PKG/bun.txt"); do run bun add -g "$p"; done; }
  want npm   && have npm   && { say "npm globals"; local p; for p in $(lines "$PKG/npm.txt"); do run npm install -g "$p"; done; }
  want go    && have go    && { say "go tools";    local p; for p in $(lines "$PKG/go.txt");  do run go install "$p@latest"; done; }
  want cargo && have cargo && { say "cargo crates"; local p; for p in $(lines "$PKG/cargo.txt"); do run cargo install --locked "$p"; done; }
  return 0
}

# ------------------------------------------------------------------ upgrade
upgrade_all() {
  load_env

  if want brew && have brew; then
    say "brew"
    run brew update
    run brew upgrade
  fi

  if want installers; then
    say "installers"
    local name detect _inst upd
    while IFS=$'\t' read -r name detect _inst upd; do
      [ -n "$name" ] || continue
      if bash -c "$detect" >/dev/null 2>&1; then runsh "$upd"; else echo "skip  $name (not installed)"; fi
    done < <(lines "$PKG/installers.tsv")
  fi

  want rustup && have rustup && { say "rustup"; run rustup update; }
  want bun    && have bun    && { say "bun globals"; run bun update -g; }
  want npm    && have npm    && { say "npm globals"; run npm update -g; }
  want go     && have go     && { say "go tools"; local p; for p in $(lines "$PKG/go.txt"); do run go install "$p@latest"; done; }
  want cargo  && have cargo  && { say "cargo crates"; local p; for p in $(lines "$PKG/cargo.txt"); do run cargo install --locked "$p"; done; }
  return 0
}

list() {
  local f
  for f in Brewfile bun.txt npm.txt go.txt cargo.txt rustup.txt node.txt apps.txt fonts.txt installers.tsv unknown.txt; do
    [ -f "$PKG/$f" ] && printf '%-16s %s entries\n' "$f" "$(lines "$PKG/$f" | wc -l | tr -d ' ')"
  done
}

case "$CMD" in
  inventory) inventory ;;
  install)   install_all ;;
  upgrade)   upgrade_all ;;
  list)      list ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
esac
